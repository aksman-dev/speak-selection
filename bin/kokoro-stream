#!/usr/bin/env python3
"""Read text on stdin, synthesize with Kokoro (local), emit wav paths on stdout.

Streams one wav per sentence segment so playback can start before the whole
text is synthesized. Used by hearmark when the engine is 'kokoro'.
"""
import os
import sys
import uuid


def _ensure_kokoro_python() -> None:
    """Use the current user's Kokoro venv before importing its dependencies."""
    venv = os.path.join(os.path.expanduser("~"), ".local", "venvs", "kokoro")
    python = os.path.join(venv, "bin", "python")
    if not os.path.isfile(python) or not os.access(python, os.X_OK):
        sys.exit(
            f"kokoro-stream: Kokoro Python is missing or not executable: {python}\n"
            f"Create the virtual environment at {venv} and install kokoro and "
            "soundfile as described in the README."
        )
    # Compare venv directories, including aliases such as macOS /var versus
    # /private/var. Resolving the interpreter itself would confuse a venv's
    # symlinked Python with the system interpreter it points to.
    if os.path.realpath(sys.prefix) == os.path.realpath(venv):
        return
    if os.path.realpath(os.path.dirname(sys.executable)) == os.path.realpath(
        os.path.dirname(python)
    ):
        sys.exit(
            f"kokoro-stream: {venv} is not a working virtual environment. "
            "Recreate it and install kokoro and soundfile as described in the README."
        )
    try:
        os.execv(python, [python, os.path.abspath(__file__), *sys.argv[1:]])
    except OSError as exc:
        sys.exit(f"kokoro-stream: could not start Kokoro Python at {python}: {exc}")


def main() -> None:
    import soundfile as sf
    from kokoro import KPipeline

    text = sys.stdin.read().strip()
    if not text:
        return
    outdir = sys.argv[1] if len(sys.argv) > 1 else "/tmp"
    voice = os.environ.get("KOKORO_VOICE", "af_heart")
    speed = float(os.environ.get("KOKORO_SPEED", "1.0"))
    pipeline = KPipeline(lang_code="a", repo_id="hexgrad/Kokoro-82M")
    run = uuid.uuid4().hex[:8]
    # Split on sentence boundaries as well as newlines (Kokoro's default is
    # newlines only, which turns a whole paragraph into one segment).
    segments = pipeline(
        text, voice=voice, speed=speed, split_pattern=r"(?<=[.!?])\s+|\n+"
    )
    for i, (graphemes, _, audio) in enumerate(segments):
        base = os.path.join(outdir, f"kokoro-{run}-{i}")
        sf.write(base + ".wav", audio, 24000)
        with open(base + ".txt", "w") as fh:
            fh.write(graphemes)
        # One segment per line: "<wav path>\t<sentence text file path>"
        print(f"{base}.wav\t{base}.txt", flush=True)

if __name__ == "__main__":
    _ensure_kokoro_python()
    main()
