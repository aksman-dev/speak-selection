#!/bin/zsh
# Speak text from stdin with Kokoro, a local neural TTS — fully offline.
# Used by the Ctrl+Option hotkey and the "Hearmark" macOS Quick
# Action; also works as a pipe:
#   echo "hello" | hearmark
# Invoking while speech is playing stops the current speech first.
set -u
# MULTIOS would combine the coprocess's input pipe with our here-string and
# leave the synthesizer waiting forever for stdin EOF.
unsetopt BG_NICE MULTIOS

TEXT=$(cat)
[[ -z "${TEXT// /}" ]] && exit 0

# Fixed path (not TMPDIR): Hammerspoon must resolve the same directory to
# send pause/rewind commands here.
CACHE_DIR="$HOME/.cache/hearmark"
mkdir -p "$CACHE_DIR" || exit 1
PIDFILE="$CACHE_DIR/speaker.pid"
LOG_FILE="$CACHE_DIR/last-run.log"

# Stop any in-progress speech (previous script instance + its afplay).
if [[ -f "$PIDFILE" ]]; then
  OLD=$(cat "$PIDFILE" 2>/dev/null)
  if [[ -n "$OLD" && "$OLD" != "$$" ]]; then
    kill -CONT "$OLD" 2>/dev/null
    kill "$OLD" 2>/dev/null
  fi
fi
pkill -f "afplay $CACHE_DIR" 2>/dev/null
echo $$ > "$PIDFILE" || exit 1

export KOKORO_VOICE=${KOKORO_VOICE:-$(cat "$HOME/.config/hearmark/voice" 2>/dev/null || echo af_heart)}
export KOKORO_SPEED=${KOKORO_SPEED:-$(cat "$HOME/.config/hearmark/speed" 2>/dev/null || echo 1.2)}
HS=${HEARMARK_HS:-/opt/homebrew/bin/hs}
CMD_FILE="$CACHE_DIR/cmd"
rm -f "$CMD_FILE"
# Hide the caption overlay and remove segment files however this script
# ends (done, killed, error).
RUN_DIR=""
kokoro_pid=""
player_pid=""
cleanup() {
  for pid in "$kokoro_pid" "$player_pid"; do
    if [[ -n "$pid" ]]; then
      kill -CONT "$pid" 2>/dev/null
      kill "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
    fi
  done
  # A replacement run may already own the shared controls and captions.
  if [[ "$(cat "$PIDFILE" 2>/dev/null)" == "$$" ]]; then
    "$HS" -c "captionHide()" </dev/null >/dev/null 2>&1
    rm -f "$PIDFILE" "$CMD_FILE"
  fi
  [[ -n "$RUN_DIR" ]] && rm -rf -- "$RUN_DIR"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
RUN_DIR=$(mktemp -d "$CACHE_DIR/run.XXXXXXXX") || exit 1
: > "$LOG_FILE" || exit 1

fail() {
  print -r -- "hearmark: $1" >> "$LOG_FILE"
  print -r -- "hearmark: $1 See $LOG_FILE" >&2
  exit "${2:-1}"
}

wait_for_exit() {
  setopt LOCAL_OPTIONS
  unsetopt POSIX_BUILTINS
  local child_pid=$1 child_status=127 next_status
  local wait_error="$RUN_DIR/wait-error"
  # zsh can queue STOP/CONT statuses before the final exit status, even
  # after the child has exited (so kill -0 cannot identify stale statuses).
  # Drain them until wait reports an unknown child. Its diagnostic separates
  # that sentinel from a legitimate exit 127; the last real status wins.
  while :; do
    wait "$child_pid" 2> "$wait_error"
    next_status=$?
    if (( next_status == 127 )) && [[ -s "$wait_error" ]]; then
      rm -f "$wait_error"
      return "$child_status"
    fi
    child_status=$next_status
  done
}

# Index-based playback over the streamed segments so Hammerspoon can steer:
# it writes "back"/"fwd" to $CMD_FILE and kills the current afplay; the
# loop then replays the previous sentence or skips to the next one.
# A coprocess keeps synthesis streaming and gives us a PID we can wait on.
# Process substitution alone loses the producer's exit status in zsh.
coproc "$HOME/.local/bin/kokoro-stream" "$RUN_DIR" <<< "$TEXT" 2> "$LOG_FILE"
kokoro_pid=$!
exec {kfd}<&p
typeset -a WAVS TXTS
eof=0
i=1
while :; do
  while (( eof == 0 && ${#WAVS} < i )); do
    if IFS=$'\t' read -r -u $kfd wav txt; then
      [[ -f "$wav" && "$wav" == *.wav ]] && { WAVS+=("$wav"); TXTS+=("$txt"); }
    else
      eof=1
    fi
  done
  (( i > ${#WAVS} )) && break
  (( i < 1 )) && i=1
  [[ -f "${TXTS[i]}" ]] && "$HS" -c "captionShow('${TXTS[i]}')" </dev/null >/dev/null 2>&1
  afplay "${WAVS[i]}" &
  player_pid=$!
  wait_for_exit "$player_pid"
  player_pid=""
  if [[ -f "$CMD_FILE" ]]; then
    c=$(<"$CMD_FILE")
    rm -f "$CMD_FILE"
    case "$c" in
      back) (( i-- )) ;;
      *) (( i++ )) ;;
    esac
  else
    (( i++ ))
  fi
done
exec {kfd}<&-
wait_for_exit "$kokoro_pid"
kokoro_status=$?
kokoro_pid=""
(( kokoro_status == 0 )) || fail "Synthesis failed (exit $kokoro_status)." "$kokoro_status"
(( ${#WAVS} > 0 )) || fail "Synthesis produced no playable audio."
exit 0
